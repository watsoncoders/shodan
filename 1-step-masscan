#!/usr/bin/env python3
"""
masscan_stream_csv.py
---------------------
Masscan network scanner that streams results directly to a CSV file in real time.

Features:
- Scans an entire CIDR block (default 0.0.0.0/0 = all IPv4).
- Outputs open ports as CSV rows with columns: ip,port,protocol,reason.
- Writes each row as soon as it is discovered (no buffering in memory).
- Supports graceful pause and resume:
    * Ctrl+C stops the current host scan and saves state (state.json).
    * On restart, the script continues with the next host from where it left off.
- Handles duplicate hosts gracefully by skipping already-processed rows.
- Provides a simple progress indicator (rows written, current host).

Prerequisites:
- Python 3.8+
- masscan (install with: go install -v github.com/robertdavidgraham/masscan/cmd/masscan)

Usage:
    python3 masscan_stream_csv.py [-c CIDR] [--rate RATE] [--limit LIMIT]

    -c CIDR      Scan only the given CIDR block (default: 0.0.0.0/0).
    --rate RATE  Masscan packet rate (default: 5000).
    --limit LIMIT Maximum number of hosts to process (default: unlimited).

The script will write:
    results.csv          (CSV of discovered open ports)
    state.json           (persistent scan state for resume)
    seen_ips.txt         (list of IPs already processed)
    progress.json        (optional per-host progress file)

Safety notes:
- The script does not attempt any authentication; it only opens known ports.
- It uses a per-host scan so you can stop after any host and resume later.
- Each host is scanned with a timeout of 30 seconds (adjustable).
"""

import argparse
import csv
import json
import subprocess
import sys
import time
from ipaddress import summarize_address_range, sum_address_ranges
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

STATE_FILE = "state.json"
SEEN_IPS_FILE = "seen_ips.txt"
PROGRESS_FILE = "progress.json"
CSV_FILE = "results.csv"


def load_state() -> Dict[str, Any]:
    state_path = Path(STATE_FILE)
    if state_path.is_file():
        with state_path.open() as f:
            return json.load(f)
    return {"last_ip": None, "last_offset": 0, "rows_written": 0}


def save_state(state: Dict[str, Any]) -> None:
    with Path(STATE_FILE).open("w") as f:
        json.dump(state, f)


def load_seen_ips() -> set:
    seen_path = Path(SEEN_IPS_FILE)
    if seen_path.is_file():
        with seen_path.open() as f:
            return {line.strip() for line in f if line.strip()}
    return set()


def save_seen_ips(seen: set) -> None:
    with Path(SEEN_IPS_FILE).open("w") as f:
        f.write("\n".join(seen))


def load_progress() -> Dict[str, Any]:
    progress_path = Path(PROGRESS_FILE)
    if progress_path.is_file():
        with progress_path.open() as f:
            return json.load(f)
    return {}


def save_progress(progress: Dict[str, Any]) -> None:
    with Path(PROGRESS_FILE).open("w") as f:
        json.dump(progress, f)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Masscan network scanner that streams results directly to a CSV file in real time."
    )
    parser.add_argument(
        "-c",
        "--cidr",
        default="0.0.0.0/0",
        help="CIDR block to scan (default: 0.0.0.0/0 = all IPv4)",
    )
    parser.add_argument(
        "--rate",
        type=int,
        default=5000,
        help="Masscan packet rate (default: 5000)",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=None,
        help="Maximum number of hosts to process (default: unlimited)",
    )
    return parser.parse_args()


def run_masscan(cidr: str, rate: int, timeout: Optional[int]) -> None:
    """Run masscan with the given options and return the Popen object."""
    cmd = [
        "masscan",
        "--rate",
        str(rate),
        "--ports",
        "80,443,8080,1883,15672,5672,8883,8443,25565,28883",
        "--wait",
        "0",
        "--banners",
        "--open",
        "--verbose",
        "--max-retries",
        "2",
        "--max-repeats",
        "2",
    ]
    if timeout is not None:
        cmd.append("--timeout")
        cmd.append(str(timeout))
    cmd.append(cidr)
    print(f"Running masscan: {' '.join(cmd)}")
    masscan = subprocess.Popen(cmd, stdout=subprocess.PIPE)
    return masscan


def format_row(ip: str, port: int, protocol: str, reason: str) -> Tuple[str, str]:
    return (ip, port, protocol, reason)


def write_csv(row: Tuple[str, int, str, str], csv_file: Path) -> None:
    """Write a single row to the CSV file and handle any errors."""
    try:
        with csv_file.open("a", newline="") as f:
            writer = csv.writer(f)
            writer.writerow(row)
    except Exception as e:
        print(f"Error writing to CSV: {e}")


def main() -> None:
    args = parse_args()
    cidr = Path(args.cidr)

    # Load state and progress data (if available)
    state = load_state()
    seen = load_seen_ips()
    progress = load_progress()

    # Check if we're resuming a previous scan
    if state["last_ip"] is not None:
        print(f"Resuming scan from {state['last_ip']}:{state['last_offset']}")
    else:
        print("Starting a new scan")

    # Compute range of remaining hosts to process
    if args.limit is not None:
        range_min, range_max = sum_address_ranges([cidr, args.limit])
    else:
        range_min, range_max = sum_address_ranges([cidr])

    # Iterate over each host in the range
    for ip in range(range_min, range_max):
        ip_str = ipaddress.ip_address(ip).exploded
        if ip_str in seen:
            print(f"Skipping already-processed host: {ip_str}")
            continue
        seen.add(ip_str)
        save_seen_ips(seen)

        # Run masscan for the current host
        masscan = run_masscan(cidr, rate=args.rate, timeout=30)
        start_time = time.time()
        while True:
            line = masscan.stdout.readline().decode("utf-8").strip()
            if not line:
                break
            # Example format: 192.168.1.100,80,tcp,open
            ip, port, protocol, reason = line.split(",")
            if reason == "open":
                row = format_row(ip, int(port), protocol, reason)
                write_csv(row, Path(CSV_FILE))
                state["rows_written"] += 1

            # Update progress data
            host_progress = progress.get(ip_str, {"start_time": time.time()})
            host_progress["end_time"] = time.time()
            progress[ip_str] = host_progress
            save_progress(progress)

            # Check for user input (Ctrl+C)
            try:
                sys.stdin.read(1)
            except KeyboardInterrupt:
                print(f"Scanning {ip_str} interrupted")
                break

        # Save state for resume
        state["last_ip"] = ip_str
        state["last_offset"] = max(0, int(port) - 1)
        save_state(state)

        # Print progress and cleanup
        print(f"Scanned {ip_str} ({state['rows_written']} rows)")
        masscan.terminate()
        del masscan
        time.sleep(1)

    # Save final progress data and state
    save_progress(progress)
    save_state(state)


if __name__ == "__main__":
    main()
